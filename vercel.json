{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/app.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/periods/:path*",
      "destination": "https://presupuesto-0qma.onrender.com/api/periods/:path*"
    },
    {
      "source": "/api/categories/:path*",
      "destination": "https://presupuesto-0qma.onrender.com/api/categories/:path*"
    },
    {
      "source": "/api/cards/:path*",
      "destination": "https://presupuesto-0qma.onrender.com/api/cards/:path*"
    },
    {
      "source": "/api/payment-methods/:path*",
      "destination": "https://presupuesto-0qma.onrender.com/api/payment-methods/:path*"
    },
    {
      "source": "/api/transactions/:path*",
      "destination": "https://presupuesto-0qma.onrender.com/api/transactions/:path*"
    },
    {
      "source": "/api/budgets/:path*",
      "destination": "https://presupuesto-0qma.onrender.com/api/budgets/:path*"
    },
    {
      "source": "/api/dashboard/:path*",
      "destination": "https://presupuesto-0qma.onrender.com/api/dashboard/:path*"
    },
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
