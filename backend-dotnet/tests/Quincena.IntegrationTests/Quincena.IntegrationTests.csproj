<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Todas las clases comparten un único Postgres real (sin Testcontainers, ver
         QuincenaWebApplicationFactory), así que correr colecciones en paralelo hace
         que tests que asumen una tabla vacía (ej. "no hay ningún período") choquen
         con fixtures de otras clases insertando/borrando al mismo tiempo. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quincena.Api\Quincena.Api.csproj" />
    <ProjectReference Include="..\..\src\Quincena.Infrastructure\Quincena.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Quincena.Application\Quincena.Application.csproj" />
  </ItemGroup>

</Project>